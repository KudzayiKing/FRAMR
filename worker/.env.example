# Required for a live worker. Use the Supabase project URL and a service-role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# mock is deterministic and has no model download; live runs YOLO with ByteTrack.
FRAMR_ANALYSIS=mock
FRAMR_POLL_SECONDS=5
FRAMR_MAX_ANALYSIS_ATTEMPTS=3
FRAMR_FFMPEG_BIN=ffmpeg
FRAMR_FFPROBE_BIN=ffprobe

# Used only when FRAMR_ANALYSIS=live. The first run may download model weights.
FRAMR_YOLO_MODEL=yolo11n.pt
FRAMR_TRACKER_CONFIG=bytetrack.yaml

# Frame-preserving pipeline foundation. The development adapters intentionally
# stop safely at unavailable model boundaries and never fall back to whole-video generation.
FRAMR_FRAME_POLL_SECONDS=5
FRAMR_FRAME_LEASE_SECONDS=300
FRAMR_FRAME_WORK_DIR=/tmp/framr-frame-preserving
# Optional stable identifier when more than one durable worker is deployed.
FRAMR_FRAME_WORKER_ID=

# Segmentation provider selection. Keep `dev` until the migration is applied and
# the local SAM checkpoint has been verified; `sam2` never sends media to a paid API.
FRAMR_SEGMENTATION_PROVIDER=dev
FRAMR_SAM2_CHECKPOINT=./models/sam2.1_hiera_tiny.pt
FRAMR_SAM2_MODEL_CONFIG=configs/sam2.1/sam2.1_hiera_t.yaml
FRAMR_SAM2_DEVICE=auto

# SAM 3 is a future CUDA-only, gated-checkpoint option. Selecting it on this
# Apple-silicon research machine stops safely rather than silently falling back.
FRAMR_SAM3_CHECKPOINT_DIRECTORY=./models/sam3
FRAMR_SAM3_DEVICE=cuda
